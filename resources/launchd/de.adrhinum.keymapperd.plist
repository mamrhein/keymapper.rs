<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>de.adrhinum.keymapperd</string>
    <key>ProgramArguments</key>
    <array>
        <string>@BINARY_PATH@</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!--
        There is deliberately no StandardOutPath/StandardErrorPath: the
        daemon writes its own rotating log file (ftlog), and launchd would
        otherwise open the same file for stdout.

        The daemon runs as the logged-in user (a LaunchAgent in gui/<UID>).
        Keyboard events are captured with a CGEventTap, which requires the
        Input Monitoring and Accessibility privacy permissions (TCC). Mapped
        keys are emitted by the root virtkbdd daemon through the DriverKit
        virtual HID driver.
    -->
</dict>
</plist>
