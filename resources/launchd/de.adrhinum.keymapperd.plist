<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>de.adrhinum.keymapperd</string>
    <key>ProgramArguments</key>
    <array>
        <string>@BINARY_PATH@</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>@LOG_DIR@/keymapperd.log</string>
    <key>StandardErrorPath</key>
    <string>@LOG_DIR@/keymapperd-err.log</string>
    <!--
        The daemon runs as root to perform IOKit device seizure. Input events
        are captured via IOHIDManager, and remapped output is emitted through
        the DriverKit virtual HID driver.
    -->
</dict>
</plist>
